# Copy to .env and fill in. Never commit .env.
PORT=3000
# development enables local conveniences; anything else (including unset) is strict.
NODE_ENV=development

DATABASE_URL=postgres://localhost:5432/seatswap
PGUSER=postgres
PGPASSWORD=
PGHOST=localhost
PGDATABASE=seatswap
PGPORT=5432

# REQUIRED outside development: a unique random value of 32+ characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Extra allowed browser origins, comma separated (e.g. https://app.example.com).
# Empty = same-origin only (plus localhost in development).
CORS_ORIGINS=

# Development only. Both are ignored unless NODE_ENV=development.
# DEMO_MODE=true  -> passwordless sign-in as the seeded sample accounts
# DEV_TOOLS=true  -> in-page developer panel (logo fetching, performance toggle)
DEMO_MODE=false
DEV_TOOLS=false
